if ! upstream="$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2> /dev/null)"; then
  exit 0
fi

[ -z "$upstream" ] && exit 0

files="$(git diff --name-only --diff-filter=ACMR "$upstream...HEAD")"

[ -z "$files" ] && exit 0

oxfmt $(echo "$files" | sed 's| |\\ |g') --no-error-on-unmatched-pattern

if ! git diff --quiet -- $(echo "$files" | sed 's| |\\ |g'); then
  echo "Oxfmt updated files. Commit those formatting changes, then push again."
  exit 1
fi
